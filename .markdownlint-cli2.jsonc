{
	// Markdown linting for docs, README, CONTEXT, ADRs (Strict tooling, CONTEXT.md).
	// MD013 line_length matches ruff's line-length = 110; code blocks and tables
	// are exempt (URLs and wide tables can't be rewrapped without breaking them).
	"config": {
		"default": true,
		"MD013": { "line_length": 110, "code_blocks": false, "tables": false },
		"MD024": { "siblings_only": true }
	},
	// Standard excluded paths, mirroring the prettier/eslint excludes in
	// .pre-commit-config.yaml (vendored bundles, jinja-carrying includes).
	"ignores": [
		"**/node_modules/**",
		"frappe_app_boilerplate/public/dist/**",
		"frappe_app_boilerplate/public/js/lib/**",
		"frappe_app_boilerplate/templates/includes/**"
	]
}
